@model EntityLayer.Concrete.Category
@{
    ViewData["Title"] = "CategoryEdit";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<h1>CategoryEdit</h1>
@using (Html.BeginForm("CategoryEdit", "Category", FormMethod.Post))
{



    @Html.Label("Kategori ID")
    @Html.TextBoxFor(x => x.CategoryID, new { @class = "form-control" })
    <br />
    @Html.Label("Kategori Başlığı")
    @Html.TextBoxFor(x => x.CategoryName, new { @class = "form-control" })

     <br />
   @Html.Label("Kategori Açıklaması")
    @Html.TextBoxFor(x => x.CategoryDescription, new { @class = "form-control" })
    <br />
    
    
    @* <br />
    @Html.Label("Blog Kategori")
    @Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.cv, new { @class = "form-control" })

    @* @Html.TextBoxFor(x=>x.CategoryID,new {@class ="form-control"}) *@
    <br />
   @*  @Html.Label("Blog İçeriği")
    @Html.TextAreaFor(x => x.BlogContent, 10, 3, new { @class = "form-control" })  *@
    <br />

    <button class="btn btn-success">Güncelle</button>
}
